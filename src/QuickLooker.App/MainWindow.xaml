<Window x:Class="QuickLooker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PicPreview"
        Height="760"
        Width="1180"
        MinHeight="560"
        MinWidth="860"
        Background="#0E1014"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#F3F5F7" />
            <Setter Property="Background" Value="#2B6BE6" />
            <Setter Property="BorderBrush" Value="#3D7AF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="GhostButton" BasedOn="{StaticResource ToolbarButton}" TargetType="Button">
            <Setter Property="Background" Value="#222730" />
            <Setter Property="BorderBrush" Value="#343B46" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F3F5F7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202630" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#273247" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3D7AF0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#181C22"
                BorderBrush="#2B3038"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="14,0">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="打开文件夹"
                            Click="OpenFolder_Click" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="打开文件"
                            Click="OpenFile_Click" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="上一张"
                            Click="Previous_Click" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="下一张"
                            Click="Next_Click" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="左旋90"
                            Click="RotateLeft_Click" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="右旋90"
                            Click="RotateRight_Click" />
                    <TextBlock Text="比例"
                               Foreground="#AEB7C2"
                               VerticalAlignment="Center"
                               Margin="4,0,6,0" />
                    <ComboBox x:Name="ZoomComboBox"
                              Width="104"
                              Height="32"
                              Margin="0,0,8,0"
                              IsEditable="True"
                              IsReadOnly="True"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0"
                              SelectionChanged="ZoomComboBox_SelectionChanged">
                        <ComboBoxItem Content="适应窗口"
                                      Tag="1" />
                        <ComboBoxItem Content="50%"
                                      Tag="0.5" />
                        <ComboBoxItem Content="75%"
                                      Tag="0.75" />
                        <ComboBoxItem Content="100%"
                                      Tag="1" />
                        <ComboBoxItem Content="125%"
                                      Tag="1.25" />
                        <ComboBoxItem Content="150%"
                                      Tag="1.5" />
                        <ComboBoxItem Content="200%"
                                      Tag="2" />
                        <ComboBoxItem Content="400%"
                                      Tag="4" />
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="FolderText"
                           Foreground="#AEB7C2"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#141820"
                    BorderBrush="#2B3038"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CountText"
                               Grid.Row="0"
                               Margin="14,0"
                               Foreground="#AEB7C2"
                               VerticalAlignment="Center"
                               Text="还没有打开图片" />

                    <ListBox x:Name="ImageList"
                             Grid.Row="1"
                             ItemsSource="{Binding Images}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ImageList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="76" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="64"
                                            Height="64"
                                            Margin="8,6"
                                            Background="#222833"
                                            BorderBrush="#343B46"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               SnapsToDevicePixels="True" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#F3F5F7"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   Foreground="#8F9AA8"
                                                   FontSize="11"
                                                   Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid x:Name="PreviewViewport"
                  Grid.Column="1"
                  Background="#0E1014"
                  ClipToBounds="True"
                  SizeChanged="PreviewViewport_SizeChanged"
                  MouseWheel="PreviewViewport_MouseWheel"
                  MouseLeftButtonDown="PreviewViewport_MouseLeftButtonDown"
                  MouseLeftButtonUp="PreviewViewport_MouseLeftButtonUp"
                  MouseMove="PreviewViewport_MouseMove">
                <Image x:Name="PreviewImage"
                       Source="{Binding CurrentPreview}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="PreviewRotateTransform"
                                             Angle="0"
                                             CenterX="0"
                                             CenterY="0" />
                            <ScaleTransform x:Name="PreviewScaleTransform"
                                            ScaleX="1"
                                            ScaleY="1" />
                            <TranslateTransform x:Name="PreviewTranslateTransform"
                                                X="0"
                                                Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <TextBlock x:Name="EmptyText"
                           Text="打开或拖入图片"
                           Foreground="#6F7885"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Border x:Name="LoadingBadge"
                        Background="#CC181C22"
                        CornerRadius="6"
                        Padding="14,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,18,0,0"
                        Visibility="Collapsed">
                    <TextBlock Text="正在载入"
                               Foreground="#F3F5F7"
                               FontSize="13" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#181C22">
            <TextBlock x:Name="StatusText"
                       Margin="14,0"
                       Foreground="#8F9AA8"
                       VerticalAlignment="Center"
                       Text="准备就绪" />
        </Border>
    </Grid>
</Window>
